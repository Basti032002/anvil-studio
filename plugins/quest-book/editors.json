          { "key": "biome", "label": "Biom (z. B. minecraft:desert)", "def": "minecraft:desert", "when": { "key": "type", "values": ["biome"] } },
          { "key": "count", "label": "Anzahl", "type": "number", "def": "1", "width": 90, "when": { "key": "type", "values": ["give", "have", "break", "place", "kill"] } }
        ]
      },
      {
