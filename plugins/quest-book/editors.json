      { "key": "claim", "label": "Belohnung abholen", "hint": "Spieler klickt im Buch auf „Abholen“ – sonst gibt es sie sofort", "type": "bool", "def": "true", "side": true },
      { "key": "notify", "label": "Hinweis beim Schaffen", "hint": "Einblendung oben rechts", "type": "bool", "def": "true", "side": true },
      { "key": "repeatable", "label": "Wiederholbar", "hint": "Kann nach der Belohnung erneut gemacht werden", "type": "bool", "def": "false", "side": true },
      { "key": "hidden", "label": "Versteckt bis frei", "hint": "Erscheint erst im Buch, wenn freigeschaltet", "type": "bool", "def": "false", "side": true }
