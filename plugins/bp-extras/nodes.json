  {
    "kind": "random_teleport",
    "cat": "player",
    "label": "Zufällig teleportieren",
    "desc": "Teleportiert das Ziel an eine zufällige Stelle im Umkreis – auf den Boden",
    "props": [
      {
        "key": "radius",
        "label": "Umkreis",
        "type": "number",
        "def": "32",
        "pin": "num"
      }
    ],
    "java": "if (target != null) {\n    double r = {{num:radius}};\n    double nx = x + (level.getRandom().nextDouble() * 2 - 1) * r, nz = z + (level.getRandom().nextDouble() * 2 - 1) * r;\n    int ny = level.getHeight(net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING, (int) Math.floor(nx), (int) Math.floor(nz));\n    target.teleportTo(nx, ny, nz);\n}"
  },
